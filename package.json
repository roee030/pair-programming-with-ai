{
  "name": "pair-flow",
  "displayName": "Pair Flow",
  "description": "Build with AI one reviewed code chunk at a time.",
  "version": "0.4.0",
  "license": "MIT",
  "publisher": "pair-flow",
  "repository": {
    "type": "git",
    "url": "https://github.com/roee030/pair-programming-with-ai.git"
  },
  "homepage": "https://github.com/roee030/pair-programming-with-ai#readme",
  "bugs": { "url": "https://github.com/roee030/pair-programming-with-ai/issues" },
  "keywords": ["ai", "pair-programming", "code-review", "human-in-the-loop", "developer-tools"],
  "galleryBanner": { "color": "#1f2933", "theme": "dark" },
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other", "Machine Learning"],
  "activationEvents": ["onCommand:pairFlow.start", "onCommand:pairFlow.setApiKey", "onView:pairFlow.view"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "pairFlow", "title": "Pair Flow", "icon": "media/pair-flow.svg" }
      ]
    },
    "views": {
      "pairFlow": [
        { "type": "webview", "id": "pairFlow.view", "name": "Pair Flow" }
      ]
    },
    "commands": [
      { "command": "pairFlow.start", "title": "Pair Flow: Start Session" },
      { "command": "pairFlow.setApiKey", "title": "Pair Flow: Set API Key" }
    ],
    "configuration": {
      "title": "Pair Flow",
      "properties": {
        "pairFlow.provider": { "type": "string", "enum": ["openai", "anthropic", "gemini", "openrouter", "ollama"], "enumDescriptions": ["OpenAI API", "Anthropic Messages API", "Google Gemini API", "OpenRouter", "Local Ollama server"], "default": "openai", "description": "AI provider used for plans and code chunks." },
        "pairFlow.baseUrl": { "type": "string", "default": "", "description": "Optional custom provider base URL. Leave empty to use the provider default." },
        "pairFlow.model": { "type": "string", "default": "", "description": "Optional model identifier. Leave empty to use the provider default." },
        "pairFlow.requestTimeoutSeconds": { "type": "number", "default": 120, "minimum": 30, "maximum": 600, "description": "Seconds before an active provider request is paused automatically." },
        "pairFlow.maxContextFiles": { "type": "number", "default": 12, "minimum": 1, "maximum": 30 }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run test && npm run typecheck && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
